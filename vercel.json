{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/schools/:slug",
      "destination": "/schools/:slug.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guides/ncaa-d1-vs-d2-vs-d3-vs-naia-vs-njcaa-track-and-field.html",
      "destination": "/guides/ncaa-d1-vs-d2-vs-d3-vs-naia-track-and-field.html",
      "permanent": true
    },
    {
      "source": "/standards/njcaa-:rest*",
      "destination": "/conferences/njcaa-track-standards.html",
      "permanent": true
    }
  ]
}